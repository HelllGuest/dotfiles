#!/usr/bin/env bash
# Global commit-msg hook: strips AI-attribution trailers regardless of which
# tool wrote the commit or what that tool's own settings default to.
# Installed via: git config --global core.hooksPath ~/dev/ai-rules/git-hooks

msg_file="$1"

sed -i.bak \
  -e '/^Co-authored-by:.*/Id' \
  -e '/^Generated[- ][Bb]y:.*/Id' \
  -e '/🤖 Generated with/Id' \
  -e '/^Co-Authored-By:.*Claude.*/Id' \
  "$msg_file"

# Also strip trailing blank lines left behind by the removals
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$msg_file"

rm -f "${msg_file}.bak"
exit 0
