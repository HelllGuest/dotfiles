# Web/dev sandbox: mise + Playwright + Chrome DevTools MCP.
FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm --needed \
      bash curl git wget unzip python python-pip \
      nodejs npm \
      nss atk at-spi2-core cups libdrm libxkbcommon libxcomposite \
      libxdamage libxfixes libxrandr mesa alsa-lib pango cairo gtk3 \
      mise \
    && pacman -Scc --noconfirm \
    && useradd -m -u 1000 lab
# mise from the signed Arch repo (was: curl https://mise.run | sh, unverified).

USER lab
ENV LAB_BADGE="[WEB]" \
    MISE_DATA_DIR=/home/lab/.local/share/mise \
    PATH="/home/lab/.local/share/mise/shims:/usr/local/bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/home/lab/.cache/ms-playwright \
    NPM_CONFIG_PREFIX=/home/lab/.npm-global
ENV PATH="/home/lab/.npm-global/bin:${PATH}"

WORKDIR /home/lab
# Playwright browsers + MCP servers (Chrome DevTools / Playwright).
# Pinned only: a failed install must fail the build, not fall back to latest.
RUN mkdir -p /home/lab/.npm-global \
 && npm install -g @playwright/mcp@0.0.39 playwright@1.49.0 \
 && npx --yes playwright install chromium

COPY --chown=lab:lab mcp-playwright.sh /usr/local/bin/mcp-playwright
COPY --chown=lab:lab mcp-devtools.sh /usr/local/bin/mcp-devtools
USER root
RUN chmod +x /usr/local/bin/mcp-playwright /usr/local/bin/mcp-devtools
USER lab
WORKDIR /work
CMD ["bash"]
