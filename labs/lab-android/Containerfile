# Android / Flutter / Kotlin SDK sandbox. KVM + Wayland passthrough at run time.
FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm \
      bash curl wget git unzip zip jdk-openjdk \
      python python-pip libx11 libxext libxrender libxi libxtst \
    && pacman -Scc --noconfirm \
    && useradd -m -u 1000 lab \
    && mkdir -p /opt/android-sdk /opt/flutter \
    && chown -R lab:lab /opt/android-sdk /opt/flutter
USER lab
ENV ANDROID_HOME=/opt/android-sdk \
    FLUTTER_HOME=/opt/flutter \
    PATH="/opt/flutter/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}" \
    LAB_BADGE="[ANDROID]"
WORKDIR /work
# SDKs are installed on first run via labs/lab-android/entrypoint.sh (large downloads).
COPY --chown=lab:lab entrypoint.sh /usr/local/bin/lab-android-entry
RUN chmod +x /usr/local/bin/lab-android-entry
ENTRYPOINT ["/usr/local/bin/lab-android-entry"]
CMD ["bash"]
