# Reverse engineering toolbox + REA backends.
# ptrace stays inside the container only — host kernel.yama.ptrace_scope untouched.
# Bare-metal host stays JDK/Ghidra-free; run: lab-re
FROM docker.io/library/archlinux:latest

# jdk-openjdk satisfies ghidra's java-environment provider non-interactively;
# JAVA_HOME still points at jdk21-openjdk for REA.
RUN pacman -Syu --noconfirm --needed \
      bash coreutils findutils file binutils gdb \
      rizin radare2 \
      jdk-openjdk jdk21-openjdk \
      ghidra jadx \
      python python-pip \
      nodejs npm \
      unzip wget curl git \
    && pacman -Scc --noconfirm \
    && useradd -m -u 1000 lab

# Pin REA inside the image (not on the host).
ARG REA_AGENTS_VERSION=6.10.1
USER root
RUN npm install -g "rea-agents@${REA_AGENTS_VERSION}" \
    && mkdir -p /opt/rea \
    && chown -R lab:lab /opt/rea

# Arch ghidra package layout; fall back if packaging moves.
ENV LAB_BADGE="[RE]" \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk \
    PATH="/usr/lib/jvm/java-21-openjdk/bin:${PATH}" \
    GHIDRA_INSTALL_DIR=/opt/ghidra \
    REA_AGENTS_VERSION=${REA_AGENTS_VERSION}

COPY --chown=lab:lab entrypoint.sh /usr/local/bin/lab-re-entry
RUN chmod +x /usr/local/bin/lab-re-entry

USER lab
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/lab-re-entry"]
CMD ["bash"]
