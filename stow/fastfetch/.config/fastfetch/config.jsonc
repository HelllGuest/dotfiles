{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "arch",
        "color": {
            "1": "yellow",
            "2": "white"
        }
    },
    "display": {
        "separator": " → "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        {
            "type": "kernel",
            "format": "{sysname} {release}"
        },
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        {
            "type": "gpu",
            "format": "{vendor} {name}"
        },
        "memory",
        {
            "type": "command",
            "key": "Firewall",
            "text": "firewall-cmd --get-default-zone 2>/dev/null || echo n/a"
        },
        {
            "type": "command",
            "key": "Lab net",
            "text": "ip -br link show virbr-malware 2>/dev/null | awk '{print $1,$2}' || echo none"
        },
        "break",
        "colors"
    ]
}
