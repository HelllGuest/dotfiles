# aliases — shared zsh/bash

_has() { command -v "$1" >/dev/null 2>&1; }

# ── Dotfiles ────────────────────────────────────────────────
alias v='nvim'
alias as='flatpak run com.google.AndroidStudio'
# ff() lives in .shell-functions so ff-preset/rice-theme overrides stay outside git.
# cargo ghidra-cli owns `ghidra`; Arch GUI via this alias
[[ -x /opt/ghidra/ghidraRun ]] && alias ghidra-gui='/opt/ghidra/ghidraRun'

# ── Safer defaults ──────────────────────────────────────────
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -Iv'
alias mkdir='mkdir -pv'
alias ln='ln -iv'

# ── Modern replacements (fallback to classic) ───────────────
if _has eza; then
    # Shared flags expanded at define-time (bash + zsh safe).
    _eza='--icons --group-directories-first --hyperlink=auto'
    alias ls="eza ${_eza}"
    alias l="eza -l --header --smart-group --git --color-scale=age ${_eza}"
    alias ll="eza -la --header --smart-group --git --color-scale=age ${_eza}"
    alias la="eza -a ${_eza}"
    alias lm="eza -l --header --smart-group --git --sort=modified --color-scale=age ${_eza}"
    alias lS="eza -l --header --smart-group --git --sort=size --color-scale=size ${_eza}"
    alias lr="eza -l --header --smart-group --git-repos --color-scale=age ${_eza}"
    alias lt="eza --tree --level=2 --git --git-ignore ${_eza}"
    alias lt3="eza --tree --level=3 --git --git-ignore ${_eza}"
    alias tree="eza --tree --git --git-ignore ${_eza}"
    unset _eza
else
    alias ls='ls --color=auto'
    alias ll='ls -la --color=auto'
    alias la='ls -A --color=auto'
fi

if _has bat; then
    alias cat='bat --paging=never'
    alias less='bat --paging=always'
else
    alias grep='grep --color=auto'
fi

_has rg && alias grep='rg'
_has fd && alias find='fd'
_has dust && alias du='dust'
_has duf && alias df='duf'
_has procs && alias ps='procs'
_has btm && alias top='btm'
_has gping && alias ping='gping'
_has delta && alias diff='delta'
_has curlie && alias curl='curlie'
_has hyperfine && alias bench='hyperfine'

# ── Navigation ──────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

# ── Git (quick) ─────────────────────────────────────────────
alias g='git'
alias gs='git status -sb'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -v'
alias gcm='git commit -m'
alias gca='git commit --amend --no-edit'
alias gcan='git commit --amend'
alias gco='git checkout'
alias gcob='git checkout -b'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --oneline --graph --decorate --all'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpu='git pull'
alias gpur='git pull --rebase'
alias gb='git branch -vv'
alias gf='git fetch --all --prune'

# ── Arch ────────────────────────────────────────────────────
alias pac='sudo pacman'
alias pacS='sudo pacman -S'
alias pacSs='pacman -Ss'
alias pacSyu='sudo pacman -Syu'
alias par='paru'
alias parS='paru -S'
alias parSyu='paru -Syu'

# ── Wayland clipboard ─────────────────────────────────────────
if _has wl-copy; then
    alias pbcopy='wl-copy'
    alias pbpaste='wl-paste'
    alias clip='wl-copy'
fi

# ── zoxide ────────────────────────────────────────────────────
# zoxide is initialized with `--cmd cd`, so `cd` (not `z`) is the jump command.
_has zoxide && alias j='cd'

# ── Disposable Kali (libvirt overlay) ───────────────────────
_dot_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
if [[ -f $_dot_dir/labs/scripts/kali-disposable.sh ]]; then
  _kali_sh="$_dot_dir/labs/scripts/kali-disposable.sh"
  alias kali="bash $_kali_sh"
  # Default start is isolated (no guest WAN) for sample work; use kali-up-nat for updates.
  alias kali-up="bash $_kali_sh start --isolated"
  alias kali-up-nat="bash $_kali_sh start --nat"
  alias kali-up-lan="bash $_kali_sh start --lan"
  alias kali-lan="bash $_kali_sh attach-lan"
  alias kali-lan-check="bash $_kali_sh lan-check"
  alias kali-wipe="bash $_kali_sh wipe"
  alias kali-stop="bash $_kali_sh stop"
  alias kali-st="bash $_kali_sh status"
  unset _kali_sh
fi

# ── Misc ────────────────────────────────────────────────────
alias cl='clear'
alias q='exit'
alias reload='exec "$SHELL" -l'
alias dotfiles="git -C $_dot_dir"
unset _dot_dir
