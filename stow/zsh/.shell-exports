# exports — shared zsh/bash environment

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export EDITOR='nvim'
export VISUAL='nvim'
export GPG_TTY=$(tty)
export LESSHISTFILE=-

if command -v bat >/dev/null 2>&1; then
    export PAGER='bat --paging=always'
    export MANPAGER='sh -c "col -bx | bat --language=man --style=plain"'
    export MANROFF_OPT='-c'
else
    export PAGER='less'
    export LESS='-RF --mouse --wheel-lines=3'
fi

# Wayland (also in /etc/environment.d on ThinkPad profile)
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export QT_QPA_PLATFORM=wayland
export SDL_VIDEODRIVER=wayland
export LIBVA_DRIVER_NAME=iHD

# PATH
_prepend_path() { [[ ":$PATH:" != *":$1:"* ]] && export PATH="$1:$PATH"; }
if [[ -n "${ZSH_VERSION:-}" ]]; then
    typeset -U path 2>/dev/null || true
fi
_prepend_path "$HOME/.local/bin"
_prepend_path "$HOME/.cargo/bin"
_prepend_path "$HOME/go/bin"
_prepend_path "${PNPM_HOME:-$HOME/.local/share/pnpm}"
_prepend_path "$HOME/.npm-global/bin"

# Android SDK
export ANDROID_HOME="$HOME/Android/Sdk"
_prepend_path "$ANDROID_HOME/platform-tools"
_prepend_path "$ANDROID_HOME/emulator"
_prepend_path "$ANDROID_HOME/cmdline-tools/latest/bin"
_prepend_path "$ANDROID_HOME/tools/bin"

# Chrome (Flutter web target; Puppeteer/Playwright/AI browser tools for UI testing)
export CHROME_EXECUTABLE="${CHROME_EXECUTABLE:-/usr/bin/google-chrome-stable}"
export CHROME_PATH="${CHROME_PATH:-$CHROME_EXECUTABLE}"
export PUPPETEER_EXECUTABLE_PATH="${PUPPETEER_EXECUTABLE_PATH:-$CHROME_EXECUTABLE}"
export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-$CHROME_EXECUTABLE}"
# Prefer JDK 17 for Android toolchain when present
if [[ -d /usr/lib/jvm/java-17-openjdk ]]; then
  export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk}"
fi

# ghidra-cli (akiselev): ~/.cargo/bin/ghidra shadows Arch GUI /usr/bin/ghidra
export GHIDRA_INSTALL_DIR="${GHIDRA_INSTALL_DIR:-/opt/ghidra}"
# Prefer newest full JDK >= 21 (Android may set JAVA_HOME to 17)
if [[ -z "${GHIDRA_CLI_JAVA_HOME:-}" ]]; then
  _ghidra_jdk=""
  _ghidra_jdk_ver=0
  for _cand in /usr/lib/jvm/java-*-openjdk; do
    [[ -x "${_cand}/bin/javac" ]] || continue
    _ver="${_cand##*/java-}"
    _ver="${_ver%%-*}"
    [[ "${_ver}" =~ ^[0-9]+$ ]] || continue
    if (( _ver >= 21 && _ver > _ghidra_jdk_ver )); then
      _ghidra_jdk="${_cand}"
      _ghidra_jdk_ver="${_ver}"
    fi
  done
  [[ -n "${_ghidra_jdk}" ]] && export GHIDRA_CLI_JAVA_HOME="${_ghidra_jdk}"
  unset _ghidra_jdk _ghidra_jdk_ver _cand _ver
fi

# Go
export GOPATH="$HOME/go"
export GOBIN="$HOME/go/bin"
export GOAMD64="${GOAMD64:-v3}"

# Rust
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
case "${RUSTFLAGS:-} " in
    *" -C target-cpu="*|*" target-cpu="*) ;;
    *) export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C target-cpu=x86-64-v3" ;;
esac

# Container CLI socket — prefer Podman when its socket exists, else Docker.
if [[ -S "${XDG_RUNTIME_DIR}/podman/podman.sock" ]]; then
  export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/podman/podman.sock"
elif [[ -S /var/run/docker.sock ]]; then
  unset DOCKER_HOST
else
  unset DOCKER_HOST
fi

# Telemetry / analytics opt-out (single source: stow/privacy environment.d)
# Also loaded for GUI apps via systemd ~/.config/environment.d/ (re-login).
_telemetry_env="${XDG_CONFIG_HOME}/environment.d/90-telemetry-optout.conf"
if [[ -f "$_telemetry_env" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$_telemetry_env"
  set +a
else
  # Minimal fallback before first stow/privacy-hardener run
  export DO_NOT_TRACK=1
  export DISABLE_TELEMETRY=1
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export NEXT_TELEMETRY_DISABLED=1
  export HEADROOM_TELEMETRY=off
fi
unset _telemetry_env
