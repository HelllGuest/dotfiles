# functions — shared zsh/bash

_has() { command -v "$1" >/dev/null 2>&1; }

# Allow functions to replace aliases. Both shells expand an alias inside
# `name() {`, so bash hits a syntax error and drops every later function.
unalias gco 2>/dev/null || true

mkcd() { mkdir -p "$1" && cd "$1" || return; }

backup() { cp "$1" "$1.bak"; }

cdls() { cd "$@" && ls -la; }

fcd() {
    _has fzf && _has fd || return 1
    local dir
    dir=$(fd --type d --hidden --follow --exclude .git 2>/dev/null | \
        fzf --preview 'eza --tree --level=2 --color=always {} 2>/dev/null || ls -la {}')
    [[ -n "$dir" ]] && cd "$dir"
}

ex() {
    if [[ -f "$1" ]]; then
        case "$1" in
            *.tar.bz2) tar xjf "$1" ;;
            *.tar.gz)  tar xzf "$1" ;;
            *.tar.xz)  tar xJf "$1" ;;
            *.tar.zst) tar --zstd -xf "$1" ;;
            *.tar)     tar xf "$1" ;;
            *.bz2)     bunzip2 "$1" ;;
            *.gz)      gunzip "$1" ;;
            *.xz)      unxz "$1" ;;
            *.zst)     zstd -d "$1" ;;
            *.zip)     unzip "$1" ;;
            *.7z)      7z x "$1" ;;
            *.rar)     unrar x "$1" ;;
            *)         echo "'$1' cannot be extracted" ;;
        esac
    else
        echo "'$1' is not a file"
    fi
}

fe() {
    _has fzf && _has fd || return 1
    local file
    file=$(fd --type f --hidden --follow --exclude .git \
        | fzf --preview 'bat --color=always --style=numbers --line-range=:100 {} 2>/dev/null || head -100 {}')
    [[ -n "$file" ]] && "${EDITOR:-nvim}" "$file"
}

rge() {
    _has fzf && _has rg || return 1
    local file line result
    result=$(rg --line-number --no-heading --color=always "$@" \
        | fzf --ansi --delimiter=: \
              --preview 'bat --color=always --style=numbers --highlight-line {2} {1} 2>/dev/null' \
              --preview-window 'right:55%:+{2}+3/3')
    [[ -z "$result" ]] && return
    file=$(echo "$result" | cut -d: -f1)
    line=$(echo "$result" | cut -d: -f2)
    "${EDITOR:-nvim}" +"$line" "$file"
}

gco() {
    if [[ -n "$1" ]]; then
        git checkout "$@"
        return
    fi
    _has fzf || { git checkout; return; }
    local branch
    branch=$(git branch --all --color=always \
        | grep -v HEAD \
        | fzf --ansi --preview 'git log --oneline --graph --color=always $(echo {} | sed s/remotes.origin.//) 2>/dev/null | head -20')
    [[ -n "$branch" ]] && git checkout "$(echo "$branch" | sed 's/remotes\/origin\///' | tr -d '* ')"
}

gai() {
    _has fzf || { git add -i; return; }
    git -c color.status=always status --short \
        | fzf --multi --ansi --preview 'git diff --color=always HEAD -- {2}' \
        | awk '{print $2}' \
        | xargs -r git add
    git status -sb
}

gshow() {
    _has fzf || { git log "$@"; return; }
    git log --graph --color=always --format="%C(auto)%h%d %s %C(dim white)%ar" "$@" \
        | fzf --ansi --no-sort --reverse \
              --preview 'echo {} | grep -o "[a-f0-9]\{7\}" | head -1 | xargs git show --color=always'
}

gcl() {
    git clone "$1" && cd "$(basename "$1" .git)"
}

mkproj() {
    local name="${1:?Usage: mkproj <name>}"
    mkdir -p "$name"/{src,tests,docs}
    cd "$name" || return
    git init
    echo "# $name" > README.md
    touch .gitignore
}

venv() {
    local dir
    for dir in .venv venv env .env; do
        if [[ -d "$dir" ]]; then
            # shellcheck disable=SC1090
            source "$dir/bin/activate"
            echo "Activated: $dir"
            return
        fi
    done
    echo "No venv found. Create with: uv venv"
}

dexec() {
    _has fzf && _has docker || return 1
    local container shell="${1:-bash}"
    container=$(docker ps --format '{{.Names}}\t{{.Image}}\t{{.Status}}' \
        | fzf --preview 'docker inspect {1} 2>/dev/null | head -40' \
        | awk '{print $1}')
    [[ -n "$container" ]] && docker exec -it "$container" "$shell"
}

fkill() {
    _has fzf || return 1
    local pid
    pid=$(ps -ef | sed 1d | fzf --multi | awk '{print $2}')
    [[ -n "$pid" ]] && echo "$pid" | xargs kill "${1:--15}"
}

bat_status() {
    # not "status": read-only special parameter in zsh
    local cap state
    cap=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null)
    state=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
    echo "Battery: ${cap}% [${state}]"
}

tmp() {
    local dir
    dir=$(mktemp -d)
    echo "→ $dir"
    cd "$dir" || return
}

httpcheck() {
    curl -o /dev/null -s -w "HTTP %{http_code} — %{time_total}s — %{url_effective}\n" "$1"
}

# ── Headroom (context compression proxy) ─────────────────────────────────
_hr_need() {
    if _has headroom; then
        return 0
    fi
    echo "headroom not installed — run: bash ~/dotfiles/scripts/install-headroom.sh" >&2
    return 127
}

hr() {
    _hr_need || return
    headroom "$@"
}

hr-claude() {
    _hr_need || return
    headroom wrap claude "$@"
}

hr-cursor() {
    _hr_need || return
    headroom wrap cursor "$@"
}

hr-proxy() {
    _hr_need || return
    # Bind localhost only (never 0.0.0.0).
    headroom proxy --host 127.0.0.1 --port "${HEADROOM_PORT:-8787}" "$@"
}

hr-opencode() {
    _hr_need || return
    headroom wrap opencode "$@"
}

hr-agy() {
    _hr_need || return
    headroom wrap agy "$@"
}

# ── Lab sandboxes (Slice 2) ──────────────────────────────────────────
# Kitty host stays stock; wrappers add Gruvbox accents via --override.
: "${LAB_ROOT:=/srv/lab}"
: "${LAB_SAMPLES:=${LAB_ROOT}/samples}"
: "${LAB_OUT:=${LAB_ROOT}/out}"

_lab_reexec_kitty() {
    # $1 title $2 accent $3 function-name; remaining args forwarded
    local title=$1 accent=$2 fn=$3
    shift 3
    [[ "${LAB_KITTY:-1}" == 1 ]] || return 1
    _has kitty || return 1
    [[ -z "${KITTY_WINDOW_ID:-}${KITTY_PID:-}" ]] || return 1
    [[ -t 1 ]] || return 1
    # bash's printf applies the format once even with no args, yielding '' (an
    # empty argument that becomes podman's container command), so guard on $#.
    local qargs=""
    (($#)) && printf -v qargs '%q ' "$@"
    exec kitty --title "$title" \
        --override "active_border_color=${accent}" \
        --override "active_tab_background=${accent}" \
        --override "tab_bar_background=#282828" \
        --override "tab_bar_margin_color=${accent}" \
        -e env LAB_KITTY=0 "$SHELL" -i -c "${fn} ${qargs}"
}

# Resolve /work bind. Never mount $HOME or / (would leak ssh/gnupg secret dirs).
# _lab_work_dir lives in scripts/lib/lab-workdir.sh (shared with lab-mcp.sh).
# Without it the labs fail closed instead of mounting an unchecked cwd.
if [[ -r "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/lib/lab-workdir.sh" ]]; then
    # shellcheck source=/dev/null
    source "${DOTFILES_DIR:-$HOME/dotfiles}/scripts/lib/lab-workdir.sh"
else
    _lab_work_dir() { echo "lab: missing \${DOTFILES_DIR:-~/dotfiles}/scripts/lib/lab-workdir.sh — refusing to mount /work" >&2; return 1; }
fi

_lab_podman() {
    # $1 image $2 badge $3 network
    # Optional podman extras: --cap-add X / --security-opt Y (until a non-flag arg)
    # Remaining args = container command
    local image=$1 badge=$2 net=$3
    shift 3
    local extras=()
    while (($#)); do
        case $1 in
            --cap-add|--security-opt)
                extras+=("$1" "$2")
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                # unknown podman flag: stop treating as extras
                break
                ;;
            *)
                break
                ;;
        esac
    done
    local samples out work
    samples=$(readlink -f -- "$LAB_SAMPLES" 2>/dev/null || echo "$LAB_SAMPLES")
    out=$(readlink -f -- "$LAB_OUT" 2>/dev/null || echo "$LAB_OUT")
    work=$(_lab_work_dir) || return 1
    [[ -d $samples ]] || { echo "lab: missing $samples — run: bash ~/dotfiles/scripts/labs-setup.sh" >&2; return 1; }
    [[ -d $out ]] || mkdir -p "$out"
    _has podman || { echo "lab: podman missing" >&2; return 1; }
    local args=(
        run --rm -it
        --security-opt no-new-privileges
        --cap-drop ALL
        "${extras[@]}"
        --userns keep-id
        --user "$(id -u):$(id -g)"
        --network "$net"
        -e "LAB_BADGE=$badge"
        -v "${samples}:/srv/lab/samples:ro,Z"
        -v "${out}:/srv/lab/out:Z"
        -v "${work}:/work:Z"
        -w /work
        "$image"
    )
    if [[ $# -gt 0 ]]; then
        podman "${args[@]}" "$@"
    else
        podman "${args[@]}"
    fi
}

lab-triage() {
    _lab_reexec_kitty "lab-triage" "#cc241d" lab-triage "$@" && return
    export LAB_BADGE="[MALWARE]"
    if podman image exists localhost/lab-triage:latest 2>/dev/null; then
        _lab_podman localhost/lab-triage:latest "[MALWARE]" none "$@"
        return
    fi
    if _has bwrap; then
        local samples work
        samples=$(readlink -f -- "$LAB_SAMPLES")
        work=$(_lab_work_dir) || return 1
        [[ -d $samples ]] || { echo "lab-triage: $samples missing" >&2; return 1; }
        bwrap --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib \
            --ro-bind /lib64 /lib64 --ro-bind /etc /etc --proc /proc --dev /dev \
            --ro-bind "$samples" /srv/lab/samples \
            --bind "$work" /work --chdir /work \
            --unshare-net --die-with-parent \
            -- "${@:-bash}"
        return
    fi
    echo "lab-triage: build image (bash ~/dotfiles/scripts/labs-setup.sh) or install bubblewrap" >&2
    return 1
}

lab-re() {
    # SYS_PTRACE: gdb / radare2 attach inside the container (host ptrace_scope untouched).
    # Default seccomp stays on: gdb runs and attaches under it; only disabling
    # ASLR for the inferior is refused (harmless warning). seccomp=unconfined
    # would expose the full syscall surface to analysed binaries.
    _lab_reexec_kitty "lab-re" "#689d6a" lab-re "$@" && return
    _lab_podman localhost/lab-re:latest "[RE]" none \
        --cap-add SYS_PTRACE "$@"
}

lab-android() {
    _lab_reexec_kitty "lab-android" "#98971a" lab-android "$@" && return
    local extra=()
    [[ -e /dev/kvm ]] && extra+=(--device /dev/kvm)
    if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
        extra+=(-e "WAYLAND_DISPLAY=${WAYLAND_DISPLAY}")
        extra+=(-v "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}:${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}")
    fi
    local samples out work
    samples=$(readlink -f -- "$LAB_SAMPLES" 2>/dev/null || echo "$LAB_SAMPLES")
    out=$(readlink -f -- "$LAB_OUT" 2>/dev/null || echo "$LAB_OUT")
    work=$(_lab_work_dir) || return 1
    [[ -d $samples ]] || { echo "lab-android: $samples missing — labs-setup.sh" >&2; return 1; }
    [[ -d $out ]] || mkdir -p "$out"
    _has podman || { echo "lab: podman missing" >&2; return 1; }
    podman run --rm -it --security-opt no-new-privileges --cap-drop ALL \
        --userns keep-id --user "$(id -u):$(id -g)" --network pasta \
        -e LAB_BADGE="[ANDROID]" \
        -v "lab-android-flutter:/opt/flutter" \
        -v "lab-android-sdk:/opt/android-sdk" \
        -v "${samples}:/srv/lab/samples:ro,Z" -v "${out}:/srv/lab/out:Z" \
        -v "${work}:/work:Z" -w /work \
        "${extra[@]}" \
        localhost/lab-android:latest "$@"
}

lab-web() {
    _lab_reexec_kitty "lab-web" "#458588" lab-web "$@" && return
    _lab_podman localhost/lab-web:latest "[WEB]" pasta "$@"
}


# ── Detonation + MCP (Slice 2b) ─────────────────────────────────────
lab-detonate() {
    bash "${DOTFILES_DIR:-${DOTFILES:-$HOME/dotfiles}}/scripts/lab-detonate.sh" "$@"
}

lab-mcp() {
    bash "${DOTFILES_DIR:-${DOTFILES:-$HOME/dotfiles}}/scripts/lab-mcp.sh" "$@"
}

# Theme overrides (rice-theme / ff-preset) stay out of ~/dotfiles: only the
# chosen names are saved under XDG_STATE_HOME, and the configs used are rebuilt
# from the stowed files each time, so repo updates still apply. Ghostty and
# Alacritty load a gitignored theme.local.* link to one of their themes/.
_rice_state() { printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/theme"; }
# _rice_get <key>: the saved name, only if it is a plain name (it goes into sed).
_rice_get() {
    local v
    v=$(cat -- "$(_rice_state)/$1" 2>/dev/null) || return 1
    [[ $v =~ ^[a-z0-9_-]+$ ]] || return 1
    printf '%s' "$v"
}
# Starship reads STARSHIP_CONFIG at every prompt; rebuilt at shell start.
_rice_starship() {
    local st pal src="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
    st=$(_rice_state)
    if pal=$(_rice_get starship) && [[ -f $src ]] && mkdir -p "$st" \
        && sed "s/^palette = .*/palette = '${pal}'/" "$src" >"$st/starship.toml"; then
        export STARSHIP_CONFIG="$st/starship.toml"
    elif [[ ${STARSHIP_CONFIG:-} == "$st/starship.toml" ]]; then
        unset STARSHIP_CONFIG
    fi
    return 0
}
_rice_starship

unalias ff btop 2>/dev/null || true
ff() {
    local p dir="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch"
    if [[ $# -eq 0 ]] && p=$(_rice_get fastfetch) && [[ -f $dir/$p.jsonc ]]; then
        fastfetch --config "$dir/$p.jsonc"
    else
        fastfetch "$@"
    fi
}

btop() {
    local t st src="${XDG_CONFIG_HOME:-$HOME/.config}/btop"
    st=$(_rice_state)
    if [[ $# -eq 0 ]] && t=$(_rice_get btop) && [[ -f $src/btop.conf ]] && mkdir -p "$st" \
        && sed "s/^color_theme = .*/color_theme = \"${t}\"/" "$src/btop.conf" >"$st/btop.conf"; then
        command btop -c "$st/btop.conf" --themes-dir "$src/themes"
    else
        command btop "$@"
    fi
}

# Fastfetch presets: ff-preset (list) | ff-preset <name> (preview) | ff-preset use <name> | ff-preset reset
ff-preset() {
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch" st
    st=$(_rice_state)
    if [[ $# -eq 0 ]]; then
        find "$dir/" -maxdepth 1 -name '*.jsonc' ! -name 'config.jsonc' -printf '%f\n' 2>/dev/null \
            | sed 's/\.jsonc$//' | sort
        return 0
    fi
    if [[ $1 == reset ]]; then
        rm -f -- "$st/fastfetch"
        echo "✓ fastfetch default → repo config.jsonc"
        return 0
    fi
    local action=preview name=$1
    if [[ $1 == use ]]; then
        action=use
        name=${2:-}
    fi
    case "$name" in
        ""|*[^a-z0-9-]*) echo "ff-preset: invalid preset '$name'" >&2; return 1 ;;
    esac
    [[ -f "$dir/$name.jsonc" ]] || { echo "ff-preset: unknown preset '$name' (run 'ff-preset' to list)" >&2; return 1; }
    if [[ $action == use ]]; then
        mkdir -p "$st" && printf '%s\n' "$name" >"$st/fastfetch" || return 1
        echo "✓ fastfetch default (local) → $name"
        _has fastfetch && fastfetch --config "$dir/$name.jsonc"
        return 0
    fi
    _has fastfetch || { echo "ff-preset: fastfetch not installed" >&2; return 1; }
    fastfetch --config "$dir/$name.jsonc"
}

# Unified theme switcher across fastfetch, btop, starship, ghostty, and alacritty.
# Usage: rice-theme [aura-glass|gruvbox|secops|reset]
rice-theme() {
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}" st
    st=$(_rice_state)
    if [[ $# -eq 0 ]]; then
        echo "themes: aura-glass | gruvbox | secops | reset (back to the repo defaults)"
        echo "active: starship=$(_rice_get starship || echo default) · btop=$(_rice_get btop || echo default) · fastfetch=$(_rice_get fastfetch || echo default)"
        return 0
    fi
    local name=$1 sp bt
    case "$name" in
        reset)
            rm -f -- "$st/fastfetch" "$st/starship" "$st/btop" "$st/starship.toml" "$st/btop.conf" \
                "$cfg/ghostty/theme.local.conf" "$cfg/alacritty/theme.local.toml" || return 1
            _rice_starship
            echo "✓ theme overrides removed: repo defaults apply"
            return 0
            ;;
        aura-glass) sp=aura_glass;   bt=aura_glass ;;
        gruvbox)    sp=gruvbox_dark; bt=gruvbox_dark ;;
        secops)     sp=secops;       bt=secops ;;
        *) echo "rice-theme: unknown theme '$name' (use: aura-glass | gruvbox | secops | reset)" >&2; return 1 ;;
    esac
    mkdir -p "$st" || return 1
    local updated=() rc=0
    if [[ -f "$cfg/fastfetch/$name.jsonc" ]]; then
        printf '%s\n' "$name" >"$st/fastfetch" && updated+=(fastfetch) || rc=1
    fi
    if [[ -f "$cfg/btop/btop.conf" && -f "$cfg/btop/themes/$bt.theme" ]]; then
        printf '%s\n' "$bt" >"$st/btop" && updated+=(btop) || rc=1
    fi
    if [[ -f "$cfg/starship.toml" ]]; then
        printf '%s\n' "$sp" >"$st/starship" && _rice_starship && updated+=(starship) || rc=1
    fi
    if [[ -f "$cfg/ghostty/themes/$name.conf" ]]; then
        ln -sfn "themes/$name.conf" "$cfg/ghostty/theme.local.conf" && updated+=(ghostty) || rc=1
    fi
    if [[ -f "$cfg/alacritty/themes/$name.toml" ]]; then
        ln -sfn "themes/$name.toml" "$cfg/alacritty/theme.local.toml" && updated+=(alacritty) || rc=1
    fi
    if (( ${#updated[@]} == 0 )); then
        echo "rice-theme: no stowed configs found under $cfg" >&2
        return 1
    fi
    echo "✓ theme → $name (${updated[*]}) [local override; repo clean; 'rice-theme reset' undoes]"
    echo "  hint: Ghostty reload Ctrl+Shift+, · Alacritty/Starship reload automatically"
    return "$rc"
}

# OSC 7: terminal CWD reporting (zsh only)
if [[ -n "${ZSH_VERSION:-}" ]]; then
    _update_terminal_cwd() {
        printf '\033]7;file://%s%s\a' "$HOST" "$PWD"
    }
    autoload -Uz add-zsh-hook
    add-zsh-hook chpwd _update_terminal_cwd
    [[ -t 1 ]] && _update_terminal_cwd   # no stray escape when stdout is not a tty
fi

# ── Long-command desktop notification (terminal-agnostic) ──────────────
# Fires notify-send when an interactive command runs longer than
# CMD_NOTIFY_THRESHOLD seconds. Hooks the shell (not the emulator), so it
# works in any emulator; where the terminal notifies natively it stands down
# (see _cmd_notify_native). Skipped on plain
# TTYs / SSH sessions with no display. Override the threshold by exporting
# CMD_NOTIFY_THRESHOLD (seconds) before the shell starts.
: "${CMD_NOTIFY_THRESHOLD:=15}"

# VTE terminals (GNOME Console, Ptyxis, GNOME Terminal) only learn that a
# command finished via vte.sh; Console uses that for its own unfocused-window
# notifications. zsh never reads /etc/profile.d, so load it here (bash: .bashrc,
# after its prompt setup, so the VTE hook sees the command's real $?).
# vte.sh (vte-common 0.84) reports "$?" after `local errsv="$?"`, i.e. always 0,
# so Console saw every command as successful. Redefine it with the saved
# status; called right after sourcing vte.sh (here for zsh, in .bashrc for bash).
_vte_fix_postexec() {
    command -v __vte_termprop_set >/dev/null 2>&1 || return 0
    __vte_precmd() {
        local errsv=$?
        __vte_termprop_set "vte.shell.postexec" "$errsv"
        __vte_termprop_signal "vte.shell.precmd"
        return $errsv
    }
}
if [[ -n "${ZSH_VERSION:-}" && -n "${VTE_VERSION:-}" && -r /etc/profile.d/vte.sh ]]; then
    # shellcheck source=/dev/null
    . /etc/profile.d/vte.sh
    _vte_fix_postexec
fi

# Terminals that notify natively, focus-aware (kitty notify_on_cmd_finish,
# Ghostty notify-on-command-finish, Console via vte.sh) when this shell is
# their direct child. The parent process decides, not inherited env vars
# (KITTY_WINDOW_ID leaks into an Alacritty started from kitty). Inside them
# the notify-send hook stands down; it still covers Alacritty, Contour, tmux,
# nested shells. Native thresholds (15 s) are set in the terminal configs.
_cmd_notify_native() {
    [[ -n "${TMUX:-}" ]] && return 1
    case "$(ps -o comm= -p "$PPID" 2>/dev/null)" in
        kitty|ghostty|kgx) return 0 ;;
    esac
    return 1
}

_cmd_notify_supported() {
    _has notify-send || return 1
    [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] || return 1
    _cmd_notify_native && return 1
    return 0
}

_cmd_notify_start() {
    _cmd_notify_cmd="$1"
    _cmd_notify_t0=$SECONDS
}

# Every path returns the command's own status: later prompt hooks (starship,
# VTE) read $? after this one.
_cmd_notify_end() {
    local ret=$?
    [[ -z "${_cmd_notify_t0:-}" ]] && return "$ret"
    local elapsed=$(( SECONDS - _cmd_notify_t0 ))
    unset _cmd_notify_t0
    (( elapsed < CMD_NOTIFY_THRESHOLD )) && return "$ret"
    _cmd_notify_supported || return "$ret"
    local cmd="${_cmd_notify_cmd:-command}" icon urgency title
    if (( ret == 0 )); then
        icon=dialog-information; urgency=normal;   title="✓ done (${elapsed}s)"
    else
        icon=dialog-error;       urgency=critical; title="✗ failed [${ret}] (${elapsed}s)"
    fi
    notify-send --app-name=shell --urgency="$urgency" --icon="$icon" \
        "$title" "$cmd" 2>/dev/null
    return "$ret"
}

# zsh: register via native hooks (order-independent, no DEBUG-trap conflicts)
if [[ -n "${ZSH_VERSION:-}" ]]; then
    _cmd_notify_preexec() { _cmd_notify_start "$1"; }
    _cmd_notify_precmd()  { _cmd_notify_end; }
    add-zsh-hook preexec _cmd_notify_preexec
    add-zsh-hook precmd  _cmd_notify_precmd
fi
# bash registration lives at the end of ~/.bashrc (after atuin/ble.sh set up
# their preexec/precmd arrays) — see .bashrc.
