[Desktop Entry]
Type=Application
Name=Kali Disposable
Comment=Disposable Kali VM (libvirt NAT / macvtap)
Exec=bash -lc "cd \\"\\${DOTFILES_DIR:-\\$HOME/dotfiles}\\" && bash labs/scripts/kali-disposable.sh start --nat"
