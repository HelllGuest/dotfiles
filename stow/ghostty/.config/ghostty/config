# Ghostty — ThinkPad X1 Yoga / GNOME 50 Wayland
# Colors: config-file theme.conf (generated by theme-switch.sh)

font-family = JetBrainsMono Nerd Font
font-size = 13
font-thicken = true
font-feature = -calt
font-feature = -liga
font-feature = -dlig

cursor-style = block
cursor-style-blink = true

# Bytes, not lines (~50 MiB; kitty uses 100k lines)
scrollback-limit = 52428800
mouse-hide-while-typing = true
copy-on-select = clipboard

window-width = 220
window-height = 50
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

gtk-titlebar = true
gtk-tabs-location = bottom
background-opacity = 0.95
# background-blur unsupported on GNOME Wayland (KDE/macOS only)
background-blur = false
window-vsync = true
bell-features = no-attention,no-title,no-system,no-border

shell-integration = detect
shell-integration-features = cursor,sudo,title

confirm-close-surface = false
focus-follows-mouse = false
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
link-url = true
gtk-prefer-dark-theme = true
class = com.mitchellh.ghostty

quick-terminal-position = top
quick-terminal-size = 40
quick-terminal-animation-duration = 0.2

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+shift+i=inspector:toggle
keybind = ctrl+grave=toggle_quick_terminal

config-file = ?theme.conf
