{
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Droid Sans Mono', 'monospace', monospace",
  "editor.fontSize": 14,
  "workbench.colorTheme": "Dark Modern",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
