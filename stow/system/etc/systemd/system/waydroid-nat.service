[Unit]
Description=Idempotent waydroid NAT masquerade (192.168.240.0/24)
Documentation=https://github.com/helllguest/dotfiles
# firewalld/nftables (and formerly UFW) cannot manage built-in nat POSTROUTING
# idempotently: reload appends copies that never flush. Keep masquerade here with
# check-before-add (-C || -A) so it is exact-once. waydroid does not add this
# rule itself; without it the container has no return path and no internet.
After=firewalld.service waydroid-container.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/bin/iptables -t nat -C POSTROUTING -s 192.168.240.0/24 -j MASQUERADE 2>/dev/null || /usr/bin/iptables -t nat -A POSTROUTING -s 192.168.240.0/24 -j MASQUERADE'
ExecStop=/bin/sh -c 'while /usr/bin/iptables -t nat -C POSTROUTING -s 192.168.240.0/24 -j MASQUERADE 2>/dev/null; do /usr/bin/iptables -t nat -D POSTROUTING -s 192.168.240.0/24 -j MASQUERADE; done'

[Install]
WantedBy=multi-user.target
