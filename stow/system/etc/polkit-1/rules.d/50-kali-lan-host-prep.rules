// Allow wheel users to run kali-lan-host-prep via pkexec without prompts.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec")
        return;
    if (!subject.isInGroup("wheel"))
        return;
    const program = action.lookup("program");
    if (program === "/usr/local/bin/kali-lan-host-prep") {
        return polkit.Result.YES;
    }
});
