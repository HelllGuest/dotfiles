// Allow wheel users to run vpn-location-sync via pkexec without repeated prompts.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec")
        return;
    if (!subject.isInGroup("wheel"))
        return;
    const program = action.lookup("program");
    if (program === "/usr/local/bin/vpn-location-sync") {
        return polkit.Result.YES;
    }
});
