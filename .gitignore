# Logs
*.log

# Caches
.cache/
.nv/
.lazy/

# Node/Python dependencies
node_modules/
__pycache__/
venv/

# Neovim local files
plugin/
packer_compiled.lua
lazy-lock.json
# Generated configs in stow
stow/nvim/.config/nvim/lua/palette.lua
stow/kitty/.config/kitty/current-theme.conf
stow/ghostty/.config/ghostty/theme.conf

# Secrets (IMPORTANT)
.env
*.key
*.pem
secrets/
.config/secrets/

# Generated theming files
theming/generated/*
!theming/generated/.gitkeep

# System/OS files
.DS_Store
Thumbs.db

# Repo-root convenience symlinks (stow targets live in stow/)
/.bashrc
/.shell-aliases
/.shell-exports
/.shell-functions

# Accidental initramfs/UKI extract artifacts (never commit)
/bin
/sbin
/lib
/lib64
/usr
/var
/etc
/dev
/proc
/run
/sys
/new_root
/kernel
/init
/init_functions
/buildconfig
/early_cpio
/config
/VERSION
