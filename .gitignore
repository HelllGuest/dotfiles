# Logs
*.log

# Caches
.cache/
.nv/
.lazy/

# VSCodium runtime state (whole ~/.config/VSCodium is stowed; only User/ configs belong in git)
stow/vscode/.config/VSCodium/*
!stow/vscode/.config/VSCodium/User/
stow/vscode/.config/VSCodium/User/*
!stow/vscode/.config/VSCodium/User/settings.json
!stow/vscode/.config/VSCodium/User/keybindings.json
!stow/vscode/.config/VSCodium/User/snippets/

# Same for the other folded editor/agent dirs: their runtime state (caches,
# globalStorage/state.vscdb with logins, Continue sessions = chat history,
# skill links from installers) lands here. Only the tracked configs belong in git.
stow/vscode/.config/Code/*
!stow/vscode/.config/Code/User/
stow/vscode/.config/Code/User/*
!stow/vscode/.config/Code/User/settings.json
!stow/vscode/.config/Code/User/keybindings.json
!stow/vscode/.config/Code/User/snippets/
stow/cursor/.config/Cursor/*
!stow/cursor/.config/Cursor/User/
stow/cursor/.config/Cursor/User/*
!stow/cursor/.config/Cursor/User/settings.json
!stow/cursor/.config/Cursor/User/keybindings.json
!stow/cursor/.config/Cursor/User/snippets/
stow/antigravity/.config/Antigravity IDE/*
!stow/antigravity/.config/Antigravity IDE/User/
stow/antigravity/.config/Antigravity IDE/User/*
!stow/antigravity/.config/Antigravity IDE/User/settings.json
!stow/antigravity/.config/Antigravity IDE/User/keybindings.json
!stow/antigravity/.config/Antigravity IDE/User/snippets/
stow/continue/.continue/*
!stow/continue/.continue/config.yaml

# GNOME extensions installed from extensions.gnome.org land in the stowed dir;
# only the custom proton-vpn indicator is tracked
stow/proton-vpn/.local/share/gnome-shell/extensions/*
!stow/proton-vpn/.local/share/gnome-shell/extensions/proton-vpn@helllguest/

# Claude Code local leftovers (runtime; never commit)
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.claude/.headroom_wrap_settings.lock
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# Node/Python dependencies
node_modules/
__pycache__/
venv/

# Neovim local files
plugin/
packer_compiled.lua
lazy-lock.json

# Secrets (IMPORTANT)
.env
*.key
*.pem
secrets/
.config/secrets/

# System/OS files
.DS_Store
Thumbs.db

# Repo-root convenience symlinks (stow targets live in stow/; not tracked)
/.bashrc
/.shell-aliases
/.shell-exports
/.shell-functions
/.shell-git
/.zshrc
/.zsh-plugins
/.config/

# Local package build trees (tracked sources live under builds/*/ )
builds/*/src/
builds/*/pkg/
builds/*/*.pkg.tar.zst
builds/*/*.tar.gz
builds/st/st-*.diff

# Accidental initramfs/UKI extract artifacts (never commit)
/bin
/sbin
/lib
/lib64
/usr
/var
/etc
/dev
/proc
/run
/sys
/new_root
/kernel
/init
/init_functions
/buildconfig
/early_cpio
/config
/VERSION

# Real home location for GeoClue (scripts/location-setup.sh); never commit
stow/system/etc/geolocation.local

# Local runtime theme overrides written by rice-theme (never dirty repo)
stow/ghostty/.config/ghostty/theme.local.conf
stow/alacritty/.config/alacritty/theme.local.toml
